# copy this to .env and fill it in (.env is gitignored, never commit it)
# local docker database. for Atlas use something like
# mongodb://<user>:<password>@<host1>:27017,<host2>:27017,<host3>:27017/cis3339?ssl=true&replicaSet=<replica set>&authSource=admin&retryWrites=true&w=majority
MONGO_URL=mongodb://localhost:27018/cis3339
PORT=3000
ORG_ID=64e0380b3cc28d087655693b
JWT_SECRET=change-me-to-a-long-random-string
# the one origin the browser is allowed to call the api from (where the frontend is served)
CORS_ORIGIN=http://localhost:5173
# demo accounts that db:init creates (these are the defaults)
SEED_VIEWER_USERNAME=user
SEED_VIEWER_PASSWORD=user
SEED_EDITOR_USERNAME=admin
SEED_EDITOR_PASSWORD=admin
